{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packagedagile.local/conductor/agents-review-packet.schema.json",
  "title": "AGENTS review packet",
  "type": "object",
  "required": ["file_identity", "client", "client_semantics", "rubric"],
  "properties": {
    "file_identity": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "client": {"enum": ["codex", "opencode"]},
    "client_semantics": {
      "type": "object",
      "required": ["precedence", "reference_loading"],
      "properties": {
        "precedence": {"type": "string", "minLength": 1},
        "reference_loading": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "mirror_identity": {"type": "string", "minLength": 1},
    "rubric": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["id", "result", "applicability", "severity", "confidence", "evidence", "finding_id", "disposition"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"},
          "result": {"enum": ["Pass", "Finding", "Not Applicable", "Unverified"]},
          "applicability": {"type": "boolean"},
          "severity": {"enum": ["Critical", "Major", "Minor", "None"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "object", "minProperties": 1},
          "finding_id": {"type": "string"},
          "disposition": {"enum": ["apply", "retain", "defer", "optional", "blocked", "none"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
